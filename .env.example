# Neon PostgreSQL Database Connection
# Get your connection string from https://neon.tech
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL=

# Optional: Resend API Key for email functionality
# Get yours at https://resend.com
RESEND_API_KEY=

# Sender for connection emails. Must be an address on a domain you have verified
# in Resend. Without this both apps fall back to Resend's sandbox sender
# (onboarding@resend.dev), which ONLY delivers to the Resend account owner's own
# address -- every visitor's confirmation email is rejected.
RESEND_FROM="Srijan Mahajan <hello@srijanmahajan.me>"

# Optional: SSH server (apps/ssh)
# Where the persistent host key is stored. A fresh key on every boot makes
# returning visitors see a host-key-changed warning.
SSH_HOST_KEY_FILE=./ssh_host_key
# SSH_BIND_ADDR=0.0.0.0
# SSH_PORT=2222
